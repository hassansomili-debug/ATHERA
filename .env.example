# ATHERA — نموذج المتغيرات | environment template
# انسخه إلى .env — لا تضع أسرارًا حقيقية في المستودع (ADR-0004 / §36.1)
# Copy to .env — never commit real secrets

APP_ENV=development
APP_DEFAULT_LOCALE=ar
APP_SUPPORTED_LOCALES=ar,en

# Database: دور التطبيق لا يملك BYPASSRLS (ADR-0002)
DATABASE_URL=postgresql+asyncpg://athera_app:athera_app_pw@localhost:5432/athera
DATABASE_MIGRATION_URL=postgresql+psycopg://athera_owner:athera_owner_pw@localhost:5432/athera

# كلمة دور التطبيق التي ينشئها الترحيل 0001. إلزامية خارج `development`:
# كلمة مكتوبة في المستودع تبقى في تاريخ git حتى بعد تغييرها.
ATHERA_DB_APP_PASSWORD=

# نطاقات الواجهة المسموح لها بمناداة الـAPI، مفصولة بفواصل (§38.6.8).
# على Vercel: https://<اسم-المشروع>.vercel.app ونطاقك المخصص.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-every-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
MFA_REQUIRED_FOR_ADMIN_ROLES=true

# Object storage (S3-compatible; MinIO in dev)
# التخزين: `s3` لأي مزوّد متوافق (AWS · R2 · Supabase · MinIO) · `none` لتعطيله.
# لا سرّ تخزين في أي متغيّر NEXT_PUBLIC_* — المتصفح لا يرى المزوّد إطلاقًا.
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=athera-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_TTL_SECONDS=300

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=athera-approvals

# Model Provider Gateway (§32 / ADR-0003)
# Sprint 0 default is "null" — no production model calls.
# null | anthropic | openai — الافتراض `null`: لا استدعاء نموذج في الإنتاج
# حتى يُختار مزود صراحةً ويُملأ مفتاحه.
MODEL_PROVIDER=null
# يلزم فقط إن كان المفتاح مرتبطًا بهوية لا بمساحة عمل.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_EXTERNAL_SEND_MAX_CLASSIFICATION=C1

# offline | openalex | crossref — الافتراض بلا شبكة
LITERATURE_REGISTRY=offline

# 1 لتفعيل إخطار Temporal عند قرارات الاعتماد
TEMPORAL_ENABLED=0

# ---------------------------------------------------------------------------
# الواجهة (Next.js) — يُضبط في Vercel لا هنا
# ---------------------------------------------------------------------------
# عنوان الـAPI كما يراه المتصفح. الواجهة لا تنادي مزود نموذج أبدًا (§38.6.8).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
